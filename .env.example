# ── Supabase (voir supabase/migrations/) ──
# Client (exposées au navigateur, valeurs "publiques" par design) :
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Serveur uniquement — SECRET, ne jamais exposer au client. Trouvable dans
# Supabase Dashboard > Project Settings > API > service_role key. Utilisée
# par les routes API (lib/supabase/server.ts) et par les scripts
# d'administration ponctuels (scripts/*.js).
SUPABASE_SERVICE_ROLE_KEY=

# ── Email transactionnel (SendGrid — mot de passe oublié, notifications) ──
# Sans ces deux variables, les emails ne partent pas (l'app continue de
# fonctionner mais logue une erreur de configuration plutôt que d'envoyer).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
